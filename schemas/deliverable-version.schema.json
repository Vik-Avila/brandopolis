{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://brandopolis.ai/schemas/deliverable-version.v1",
  "title": "deliverable-version",
  "x-version": "v1",
  "description": "ADR-0030 / PHASE4_SPEC §4.4 · editable content of one version of a deliverable: sales presentation, offer copy, social post, ad or brief for a designer/Canva. The body is typed per deliverable type. Origin (decision versions, offer version) and provenance are decided by the server and stored beside the content. Immutable once it leaves DRAFT. Nothing here publishes or spends: a social post or ad is text for a person to use; publication of a social post is recorded manually.",
  "properties": {
    "type": { "type": "string", "enum": ["SALES_PRESENTATION", "OFFER_COPY", "SOCIAL_POST", "AD", "DESIGN_BRIEF"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "offerId": { "type": ["string", "null"], "maxLength": 200 },
    "sourceDecisionVersionIds": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "body": { "type": "object" }
  },
  "required": ["type", "name", "offerId", "sourceDecisionVersionIds", "body"],
  "allOf": [
    { "if": { "properties": { "type": { "const": "SALES_PRESENTATION" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/salesPresentation" } } } },
    { "if": { "properties": { "type": { "const": "OFFER_COPY" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/offerCopy" }, "offerId": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "type": { "const": "SOCIAL_POST" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/socialPost" } } } },
    { "if": { "properties": { "type": { "const": "AD" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/ad" } } } },
    { "if": { "properties": { "type": { "const": "DESIGN_BRIEF" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/designBrief" } } } }
  ],
  "$defs": {
    "text": { "type": "string", "maxLength": 3000 },
    "salesPresentation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "audience": { "type": "string", "maxLength": 500 },
        "slides": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "text": { "type": "string", "maxLength": 1200 } }, "required": ["title", "text"] } }
      },
      "required": ["audience", "slides"]
    },
    "offerCopy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "maxLength": 160 },
        "short": { "type": "string", "maxLength": 300 },
        "long": { "$ref": "#/$defs/text" },
        "callToAction": { "type": "string", "maxLength": 80 }
      },
      "required": ["headline", "short", "long", "callToAction"]
    },
    "socialPost": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "network": { "type": "string", "enum": ["INSTAGRAM", "FACEBOOK", "LINKEDIN", "TIKTOK", "X", "OTHER"] },
        "format": { "type": "string", "enum": ["POST", "CAROUSEL", "REEL", "STORY", "VIDEO", "ARTICLE"] },
        "objective": { "type": "string", "maxLength": 300 },
        "scheduledDate": { "type": ["string", "null"], "format": "date" },
        "text": { "type": "string", "maxLength": 2200 },
        "hashtags": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
        "materials": { "type": "string", "maxLength": 1000 }
      },
      "required": ["network", "format", "objective", "scheduledDate", "text", "hashtags", "materials"]
    },
    "ad": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "enum": ["GOOGLE", "META", "LINKEDIN", "OTHER"] },
        "objective": { "type": "string", "enum": ["AWARENESS", "TRAFFIC", "LEADS", "SALES"] },
        "headlines": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "minLength": 1, "maxLength": 90 } },
        "descriptions": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "callToAction": { "type": "string", "maxLength": 80 },
        "landingUrl": { "type": ["string", "null"], "maxLength": 500, "pattern": "^https://" }
      },
      "required": ["channel", "objective", "headlines", "descriptions", "callToAction", "landingUrl"]
    },
    "designBrief": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "for": { "type": "string", "enum": ["DESIGNER", "CANVA"] },
        "piece": { "type": "string", "minLength": 1, "maxLength": 300 },
        "format": { "type": "string", "maxLength": 200 },
        "audience": { "type": "string", "maxLength": 500 },
        "message": { "type": "string", "maxLength": 1000 },
        "mustInclude": { "type": "string", "maxLength": 1000 },
        "avoid": { "type": "string", "maxLength": 1000 },
        "dueDate": { "type": ["string", "null"], "format": "date" },
        "design": {
          "description": "Block 8 · design retrieved from Canva into a NEW version of the brief (CNV-001); simulated while only the simulator exists.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "provider": { "const": "CANVA" },
            "designRef": { "type": "string", "minLength": 1, "maxLength": 200 },
            "format": { "const": "PNG" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "pages": { "type": "integer", "minimum": 1, "maximum": 100 },
            "simulated": { "type": "boolean" },
            "retrievedAt": { "type": "string", "format": "date-time" }
          },
          "required": ["provider", "designRef", "format", "sha256", "pages", "simulated", "retrievedAt"]
        }
      },
      "required": ["for", "piece", "format", "audience", "message", "mustInclude", "avoid", "dueDate"]
    }
  },
  "examples": [
    { "type": "SOCIAL_POST", "name": "Lanzamiento del diagnóstico", "offerId": null, "sourceDecisionVersionIds": [], "body": { "network": "LINKEDIN", "format": "POST", "objective": "Dar a conocer el diagnóstico", "scheduledDate": "2026-11-03", "text": "Ordena tu estrategia antes de producir materiales.", "hashtags": ["#marca"], "materials": "Imagen con el logotipo" } }
  ]
}
