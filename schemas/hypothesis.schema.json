{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://brandopolis.ai/schemas/hypothesis.v1",
  "title": "hypothesis",
  "x-version": "v1",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "brandId": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "UNTESTED",
        "TESTING",
        "SUPPORTED",
        "WEAKENED",
        "REJECTED"
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "brandId",
    "statement",
    "status",
    "evidenceReferences"
  ],
  "examples": [
    {
      "id": "h-1",
      "brandId": "b-1",
      "statement": "agencias regresarán",
      "status": "UNTESTED",
      "evidenceReferences": []
    }
  ]
}
