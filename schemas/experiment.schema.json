{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://brandopolis.ai/schemas/experiment.v1",
  "title": "experiment",
  "x-version": "v1",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "brandId": {
      "type": "string",
      "minLength": 1
    },
    "hypothesisId": {
      "type": "string",
      "minLength": 1
    },
    "intendedSignal": {
      "type": "string",
      "minLength": 1
    },
    "ownerUserId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "COMPLETED",
        "INCONCLUSIVE",
        "CANCELLED"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "disconfirmingCriteria": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "plannedPeriod": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 10
    }
  },
  "required": [
    "id",
    "brandId",
    "hypothesisId",
    "intendedSignal",
    "ownerUserId",
    "status"
  ],
  "examples": [
    {
      "id": "exp-1",
      "brandId": "b-1",
      "hypothesisId": "h-1",
      "intendedSignal": "segundo evento",
      "ownerUserId": "u-1",
      "status": "PLANNED"
    }
  ]
}
