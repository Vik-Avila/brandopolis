{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://brandopolis.ai/schemas/capability-evidence.v1",
  "title": "capability-evidence",
  "x-version": "v1",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "decisionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "userId",
    "capability",
    "behavior",
    "decisionId",
    "observedAt"
  ],
  "examples": [
    {
      "id": "ce-1",
      "userId": "u-1",
      "capability": "Customer Understanding",
      "behavior": "comparó segmentos",
      "decisionId": "d-1",
      "observedAt": "2026-09-24T12:00:00Z"
