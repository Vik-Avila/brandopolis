{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://brandopolis.ai/schemas/learning.v1",
  "title": "learning",
  "x-version": "v1",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "brandId": {
      "type": "string",
      "minLength": 1
    },
    "signalIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "REVIEWED",
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "hypothesisId": {
      "type": "string",
      "minLength": 1
    },
    "supports": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "doesNotSupport": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "alternativeExplanations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 10
    },
    "origin": {
      "enum": [
        "MANUAL",
        "BRANDO_ASSISTED"
      ]
    }
  },
  "required": [
    "id",
    "brandId",
    "signalIds",
    "interpretation",
    "limitations",
    "status",
    "reviewedBy"
  ],
  "examples": [
    {
      "id": "l-1",
      "brandId": "b-1",
      "signalIds": [
        "sig-1"
      ],
      "interpretation": "Posible interés recurrente",
      "limitations": [
        "único caso"
      ],
      "status": "CANDIDATE",
      "reviewedBy": null
    }
  ]
}
