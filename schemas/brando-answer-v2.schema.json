{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brandopolis.ai/schemas/brando-answer.v2",
  "title": "brando-answer-v2",
  "x-version": "v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "referenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "text",
          "referenceIds"
        ]
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      }
    },
    "suggestionActions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "STRATEGY",
              "EVIDENCE",
              "CONTEXT"
            ]
          },
          "proposedDecision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2500
          }
        },
        "required": [
          "kind",
          "proposedDecision"
        ]
      }
    }
  },
  "required": [
    "answer",
    "facts",
    "hypotheses",
    "suggestions",
    "questions",
    "limitations"
  ],
  "examples": [
    {
      "answer": "Consulta el contexto disponible.",
      "facts": [],
      "hypotheses": [],
      "suggestions": [],
      "questions": [
        "¿Qué necesitas comprender?"
      ],
      "limitations": [
        "No hay evidencia suficiente."
      ]
    }
  ]
}
