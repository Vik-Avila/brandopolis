# Canonical Brand Master and its byte-identical runtime copies are validated by SHA-256.
# Keep them exactly as committed: no line-ending conversion (core.autocrlf would otherwise rewrite SVG/JSON/manifest bytes).
design/brandopolis-ui/brand-master/final-canonical-2026-09-25/** -text
public/brand/** -text
# Applied migrations are immutable and hash-checked (readiness/migrationPlan compare the file hash to
# what the database recorded). With core.autocrlf a checkout rewrote these to CRLF, the hash changed and
# a healthy database reported MIGRATIONS_REQUIRED. Pin them to LF on every OS.
drizzle/** text eol=lf

# Runtime frontend is served byte-for-byte (ETag = content hash): keep LF on every OS.
src/transport/public/** text eol=lf

# UI kit files hashed by design/brandopolis-ui/validation/validate.py (specs/brand-assets.json): byte-exact on every OS.
design/brandopolis-ui/assets/logo/README.md -text
design/brandopolis-ui/assets/logo/brandopolis-logo-horizontal-flat-outlined.svg -text
design/brandopolis-ui/assets/symbols/brandopolis-symbol-flat.svg -text
design/brandopolis-ui/reference/screenshots/README.md -text
public/brand/logo/brandopolis-logo-horizontal.svg -text
public/brand/symbols/brandopolis-symbol.svg -text
public/brand/ui/site.webmanifest -text

# Engineering Skill Pack: .claude/skills must stay byte-identical to .agents/skills on every OS.
# text=auto: text files are checked out with LF; binaries (PNG, fonts) are left untouched.
.agents/skills/** text=auto eol=lf
.claude/skills/** text=auto eol=lf
