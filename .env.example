# M1 local DEMO. Vacío utiliza la DB creada por pnpm db:start.
DATABASE_URL=
# Para PostgreSQL externo: configurar localmente una URL privada, nunca commitearla.
# El servidor M1 rechaza NODE_ENV=production; auth final aún no implementada.
NODE_ENV=development

# ── PILOT (sólo en el entorno de despliegue; nunca en este archivo con valores reales) ──
# Ver docs/15-handoff/PILOT_RUNBOOK.md. Competition tooling rechaza DATABASE_URL: no mezclar perfiles.
# PILOT_DATA_CLASS=PILOT
# PILOT_ORIGIN=https://pilot.example.com
# PORT=3000
# BIND_HOST=127.0.0.1
# TRUST_PROXY=true
# OIDC_ISSUER=https://issuer.example.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PUBLIC_CLIENT=false
# OIDC_REDIRECT_URI=https://pilot.example.com/auth/callback
# PILOT_REQUEST_ACCESS_URL=mailto:pilot@example.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_TIMEOUT_MS=30000
# PILOT_BACKUP_FILE=
# PILOT_RECOVERY_VERIFIED=
# PILOT_RESTORE_CONFIRM=
# PG_BIN=
