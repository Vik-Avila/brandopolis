# M1 local DEMO. Vacío utiliza la DB creada por pnpm db:start.
DATABASE_URL=
# Para PostgreSQL externo: configurar localmente una URL privada, nunca commitearla.
# El servidor M1 rechaza NODE_ENV=production; auth final aún no implementada.
NODE_ENV=development

# ── PILOT (sólo en el gestor de secretos del hosting; nunca valores reales aquí) ──
# Matriz completa: docs/15-handoff/PILOT_DEPLOYMENT_CONTRACT.md. Validar con: pnpm pilot:validate-config
# Competition tooling rechaza DATABASE_URL: no mezclar perfiles DEMO y PILOT.
# PILOT_DATA_CLASS=PILOT
# PILOT_ORIGIN=https://pilot.<tu-dominio>
# OIDC_ISSUER=https://<issuer>/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PUBLIC_CLIENT=false
# OIDC_REDIRECT_URI=
# PORT=3000
# BIND_HOST=127.0.0.1
# TRUST_PROXY=false
# PILOT_REQUEST_ACCESS_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_TIMEOUT_MS=30000
# PILOT_AI_DAILY_CAP_PER_TESTER=30
# PILOT_AI_DAILY_CAP_TOTAL=300
# PILOT_AI_NOTICE_FILE=config/pilot/ai-notice.v1.md
# PG_BIN=
# Operación puntual: PILOT_BACKUP_FILE, PILOT_RECOVERY_VERIFIED, PILOT_RESTORE_CONFIRM
# Sólo ensayos locales, nunca en Internet: PILOT_LOCAL_REHEARSAL=true
